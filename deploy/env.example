# Скопируйте в .env.production в корне репозитория (не коммитьте).

# Обязательно: тот же токен, что у API (заголовок x-admin-token для админки через Next).
ADMIN_TOKEN=замените_на_длинную_случайную_строку

POSTGRES_PASSWORD=замените_на_надёжный_пароль

# Разрешённые origin для CORS у Nest (можно несколько через запятую).
WEB_ORIGIN=https://custom.slavalarionov.com

# База для абсолютных ссылок в ответах API (если где-то ещё используется).
PUBLIC_BASE_URL=https://custom.slavalarionov.com

# Опционально: ключ Яндекс.Карт для сборки фронта.
# NEXT_PUBLIC_YANDEX_API_KEY=

# Какой конфиг nginx использовать:
#   default.conf      — только HTTP (стартовый деплой, до выпуска сертификата);
#   default-tls.conf  — HTTPS на 443 + редирект с 80 (после certbot).
NGINX_CONF_FILE=default.conf
